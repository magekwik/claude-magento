<?xml version="1.0"?>
<config>
    <group id="default">
        <job name="acme_feed_export" instance="Acme\Feed\Cron\ExportProducts" method="execute">
            <schedule>*/30 * * * *</schedule>
        </job>
        <job name="acme_feed_cleanup" instance="Acme\Feed\Cron\Cleanup" method="execute"/>
        <job instance="Acme\Feed\Cron\StockSync"
             method="execute"
             name="acme_feed_stock_sync">
            <config_path>acme_feed/stock/schedule</config_path>
        </job>
    </group>
</config>
